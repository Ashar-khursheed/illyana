# Chat transcript email (free). Copy to .env.local locally, and add the same keys in Vercel → Settings → Environment Variables.
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
# Where finished chats are sent (comma-separate for several inboxes)
TRANSCRIPT_TO=hello@ilyanadigital.com
# Optional custom sender, e.g. "Ilyana Website <you@gmail.com>"
SMTP_FROM=
